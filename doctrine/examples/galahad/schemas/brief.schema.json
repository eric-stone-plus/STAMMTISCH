{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "galahad.brief.v0",
  "title": "GALAHAD research brief (materialized from briefs/brief.template.json)",
  "type": "object",
  "required": ["schema", "title", "pipeline", "run_id", "pack_sha256", "objectives", "acceptance_gates"],
  "additionalProperties": true,
  "properties": {
    "schema": {"const": "galahad.brief.v0"},
    "title": {"type": "string", "minLength": 1},
    "pipeline": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "pack_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "objectives": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "acceptance_gates": {"type": "array", "items": {"type": "string"}}
  }
}
