# Example systemd user unit. Copy to ~/.config/systemd/user/stammtisch-decide.service,
# adjust every %h/.local/opt/STAMMTISCH occurrence to your local checkout,
# then run: systemctl --user daemon-reload
[Unit]
Description=STAMMTISCH daily position decision (scan -> GALAHAD adjust -> persist)
Documentation=file://%h/.local/opt/STAMMTISCH/tui/decide.py
# Decisions read the workstation config and the private quantkit install.
After=network-online.target

[Service]
Type=oneshot
# The venv python resolves its own dependencies; %h keeps the unit
# portable across operator home directories.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/.local/opt/STAMMTISCH
# One round = three zones x (scan + one model pass); Kronos forecasts add
# minutes more. The runner is idempotent per day, so a timeout just skips
# today's redo.
TimeoutStartSec=2700
# Trading-calendar guard (weekend level): the 08:30 UTC slot serves the
# Mon-Fri A-share/HK close plus the US Friday close on Saturday. Sunday has
# no new closes anywhere since the Saturday run — exit cleanly instead of
# re-scanning stale data. Exchange holidays are out of scope here.
ExecStart=/usr/bin/bash -c 'if [ "$(date +%%u)" = "7" ]; then echo "decide: Sunday, no new closes since Saturday run — skipping"; exit 0; fi; exec %h/.local/opt/STAMMTISCH/.venv/bin/python -m tui.decide'
